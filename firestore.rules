rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitives
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isAdmin() { 
      return isSignedIn() && (
        (request.auth.token.email == 'adolamer9@gmail.com') || 
        (request.auth.token.email == 'zanyarshkurd@gmail.com') || 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      ); 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // Validation Blueprint for User
    function isValidUser(data) {
      return data.keys().hasAll(['points', 'level', 'dailyZikrsCompleted', 'totalTasbihCount', 'badges', 'updatedAt']) &&
             data.points is number && data.points >= 0 &&
             data.level is number && data.level >= 1 &&
             data.dailyZikrsCompleted is number && data.dailyZikrsCompleted >= 0 &&
             data.totalTasbihCount is number && data.totalTasbihCount >= 0 &&
             data.badges is list &&
             data.updatedAt is string &&
             (!('deviceId' in data) || data.deviceId is string) &&
             (!('totalDhikrs' in data) || data.totalDhikrs is number) &&
             (!('currentLevel' in data) || data.currentLevel is number) &&
             (!('lastActive' in data) || data.lastActive is string) &&
             (!('status' in data) || data.status is string) &&
             (!('history' in data) || data.history is list) &&
             (!('totalAyahsRead' in data) || data.totalAyahsRead is number) &&
             (!('profileName' in data) || data.profileName is string) &&
             (!('profileImage' in data) || data.profileImage is string) &&
             (!('dailyGoal' in data) || data.dailyGoal is number) &&
             (!('userNo' in data) || data.userNo is number) &&
             (!('role' in data) || (data.role is string && (data.role == 'user' || data.role == 'admin')));
    }

    function isValidZikrStat(data) {
      return data.keys().hasAll(['id', 'title', 'viewCount', 'lastViewed']) &&
             data.keys().size() >= 4 && data.keys().size() <= 6 &&
             data.id is string &&
             data.title is string &&
             data.viewCount is number &&
             data.lastViewed is string &&
             (!('completionCount' in data) || data.completionCount is number) &&
             (!('totalClicks' in data) || data.totalClicks is number);
     }

    function isValidHadithCount(data) {
      return data.keys().hasAll(['count']) &&
             data.keys().size() == 1 &&
             data.count is number;
    }

    function isValidHadith(data) {
      return data.keys().hasAll(['arabic', 'kurdish', 'source', 'reference', 'topic', 'createdAt']) &&
             data.keys().size() >= 6 &&
             data.arabic is string && data.arabic.size() <= 5000 &&
             data.kurdish is string && data.kurdish.size() <= 5000 &&
             data.source is string &&
             data.reference is string &&
             data.topic is string &&
             data.createdAt is string;
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['name', 'message', 'timestamp', 'email']) &&
             data.keys().size() >= 4 && data.keys().size() <= 5 &&
             data.name is string && data.name.size() <= 200 &&
             data.message is string && data.message.size() <= 10000 &&
             data.email is string && data.email.size() <= 200 &&
             data.timestamp is timestamp &&
             (!('userId' in data) || data.userId == null || data.userId is string);
    }

    match /users/{userId} {
      allow get, list: if true;
      
      allow create: if isValidId(userId) && isValidUser(incoming()) && 
                    (!('role' in incoming()) || incoming().role == 'user');
      
      allow update: if isValidId(userId) && isValidUser(incoming()) && 
                    (isAdmin() || (isOwner(userId) && (!('role' in incoming()) || ('role' in existing() ? incoming().role == existing().role : incoming().role == 'user'))));
      
      allow delete: if false;
    }

    match /zikr_stats/{zikrId} {
      allow read: if true;
      allow create: if isValidId(zikrId) && isValidZikrStat(incoming());
      allow update: if true;
    }

    match /hadith_counts/{sourceId} {
      allow read, write: if true;
    }

    match /hadiths/{hadithId} {
      allow read: if true;
      allow write: if true;
    }

    match /messages/{messageId} {
      allow read: if isAdmin();
      allow create: if messageId is string && messageId.size() <= 128 &&
                      incoming().name is string && incoming().name.size() <= 200 &&
                      incoming().message is string && incoming().message.size() <= 10000;
      allow update, delete: if isAdmin();
    }

    match /global_stats/{statId} {
      allow read: if true;
      allow write: if isValidId(statId);
    }

    match /admins/{adminId} {
      // Allow user to check their own admin status
      allow get: if isOwner(adminId);
      allow list: if false;
      allow write: if false;
    }
  }
}
